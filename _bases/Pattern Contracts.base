filters:
  and:
    - type == "pattern-contract"
properties:
  status:
    displayName: Status
  owner:
    displayName: Owner
  surfaces:
    displayName: Surfaces
  source:
    displayName: Source
  maturity_score:
    displayName: Maturity
  last_reviewed:
    displayName: Last reviewed
views:
  - type: table
    name: Pattern contracts
    order:
      - file.name
      - status
      - surfaces
      - source
      - maturity_score
      - last_reviewed

